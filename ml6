
import gymnasium as gym
import numpy as np
import random
import matplotlib.pyplot as plt

# Initialize the environment for training
env = gym.make('Taxi-v4')

n_states = env.observation_space.n
n_actions = env.action_space.n
Q = np.zeros((n_states, n_actions))

# hyperparameters
alpha = 0.8
gamma = 0.95
epsilon = 1.0
min_epsilon = 0.01
decay = 0.9995
episodes = 20000
max_steps = 200
rewards = []
success_count = 0

for ep in range(episodes):
    state, info = env.reset()
    total_reward = 0
    done = False
    for step in range(max_steps):
        if random.random() < epsilon:
            action = env.action_space.sample()
        else:
            action = int(np.argmax(Q[state]))

        # Gymnasium step returns 5 values: observation, reward, terminated, truncated, info
        next_state, reward, terminated, truncated, _ = env.step(action)
        done = terminated or truncated

        Q[state, action] += alpha * (reward + gamma * np.max(Q[next_state]) - Q[state, action])
        state = next_state
        total_reward += reward
        if done:
            if reward == 20: # successful dropoff reward
                success_count += 1
            break
    rewards.append(total_reward)
    epsilon = max(min_epsilon, epsilon * decay)

# Evaluation
print("Training finished.")
print("Average reward (last 1000):", np.mean(rewards[-1000:]))
print("Successes during training:", success_count)

# Plot rewards
plt.plot(rewards)
plt.title('Episode rewards')
plt.show()

# Play a few episodes with greedy policy and render in text mode
eval_env = gym.make('Taxi-v4', render_mode='ansi')
for ep in range(5):
    state, info = eval_env.reset()
    done = False
    total = 0
    steps = 0
    while not done and steps < 200:
        action = int(np.argmax(Q[state]))
        state, reward, terminated, truncated, _ = eval_env.step(action)
        done = terminated or truncated
        total += reward
        steps += 1
        print(eval_env.render())

    print(f"Episode {ep} finished in {steps} steps with reward {total}")
    print("-"*40)
